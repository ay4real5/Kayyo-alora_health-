# Copy to .env and fill in. Never commit .env.

# Database
DATABASE_URL=postgresql://alora:localdev123@localhost:5432/alora_health

# Redis
REDIS_URL=redis://:localdev123@localhost:6379

# Auth — JWT_SECRET is required, min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
PASSWORD_MAX_AGE_DAYS=90

# CORS — exact origins only, comma-separated (no wildcards, see DECISIONS D-008)
CORS_ORIGINS=http://localhost:3000

# AWS S3 (HIPAA-eligible, BAA required)
AWS_REGION=us-east-1
AWS_S3_BUCKET=alora-health-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Notifications outside the app (D-071). Each channel stays off until its settings are filled in — only after the
# provider signed a BAA. Twilio SMS: all three (number in E.164, e.g. +15551234567).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_IVR_PHONE_NUMBER=

# Push to the mobile app through Expo's push service: PUSH_PROVIDER=expo (empty = off). The access token only if the
# Expo project requires authenticated push.
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=

# SendGrid email (notification emails link to FRONTEND_URL).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@youragency.com

# Google Maps
GOOGLE_MAPS_API_KEY=

# EDI / Clearinghouse
CLEARINGHOUSE_SFTP_HOST=
CLEARINGHOUSE_SFTP_USER=
CLEARINGHOUSE_SFTP_KEY_PATH=

# PHI encryption — 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PHI_ENCRYPTION_KEY=
# Bump when rotating keys; move the old key into PREVIOUS_KEYS so existing values still decrypt.
PHI_ENCRYPTION_KEY_VERSION=1
# Retired keys, comma-separated "<version>:<base64 key>", e.g. 1:abc...=,2:def...=
PHI_ENCRYPTION_PREVIOUS_KEYS=

# Web dashboard (apps/web): where the browser reaches the API. The API's CORS_ORIGINS must include the
# dashboard's origin (http://localhost:3000 in development).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# App
APP_PORT=3001
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# Background jobs (late/no-show alerts, nightly recurring-visit extension). Default true; API e2e tests set false.
JOBS_ENABLED=true
# Whole months of audit history kept before the audit-partitions job drops them (HIPAA minimum: 72).
AUDIT_RETENTION_MONTHS=72

# Database connections per API instance (default 10).
DATABASE_POOL_SIZE=10

# Reverse proxies in front of the API (1 behind the nginx in docker-compose.prod.yml; 0 when reached directly).
TRUST_PROXY_HOPS=0

# Only for automated browser tests (many sign-ins a minute from one IP). Never in production (the API refuses).
RATE_LIMITS_DISABLED=false
