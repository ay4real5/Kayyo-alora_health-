# Copy to .env and fill in. Never commit .env.

# Database
DATABASE_URL=postgresql://alora:localdev123@localhost:5432/alora_health

# Redis
REDIS_URL=redis://:localdev123@localhost:6379

# Auth — JWT_SECRET is required, min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
PASSWORD_MAX_AGE_DAYS=90

# CORS — exact origins only, comma-separated (no wildcards, see DECISIONS D-008)
CORS_ORIGINS=http://localhost:3000

# AWS S3 (HIPAA-eligible, BAA required)
AWS_REGION=us-east-1
AWS_S3_BUCKET=alora-health-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_IVR_PHONE_NUMBER=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@youragency.com

# Google Maps
GOOGLE_MAPS_API_KEY=

# EDI / Clearinghouse
CLEARINGHOUSE_SFTP_HOST=
CLEARINGHOUSE_SFTP_USER=
CLEARINGHOUSE_SFTP_KEY_PATH=

# PHI encryption — 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PHI_ENCRYPTION_KEY=
# Bump when rotating keys; move the old key into PREVIOUS_KEYS so existing values still decrypt.
PHI_ENCRYPTION_KEY_VERSION=1
# Retired keys, comma-separated "<version>:<base64 key>", e.g. 1:abc...=,2:def...=
PHI_ENCRYPTION_PREVIOUS_KEYS=

# App
APP_PORT=3001
APP_ENV=development
FRONTEND_URL=http://localhost:3000
