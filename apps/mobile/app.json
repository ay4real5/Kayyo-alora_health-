{
  "expo": {
    "name": "Primordial Caregiver",
    "slug": "primordial-caregiver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "primordial",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Primordial Health with Face ID so patient information stays protected."
      },
      "bundleIdentifier": "health.primordialhealthservices.caregiver",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "allowBackup": false,
      "package": "health.primordialhealthservices.caregiver",
      "versionCode": 1,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Primordial Health with Face ID so patient information stays protected."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Primordial Health records your location when you clock in and out of a visit, to verify the visit (electronic visit verification).",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1e1b4b",
          "image": "./assets/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Primordial Health to access your photos to send them in messages."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "21b21363-faf1-4e83-a113-45483213a5ad"
      }
    },
    "owner": "ay4real1128"
  }
}