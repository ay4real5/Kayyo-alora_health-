# Production settings for docker-compose.prod.yml (D-070). Copy to .env.production on the server, fill in, and
# NEVER commit it. Every secret here must be new — none of the development values (DECISIONS D-019, P4-12).

# The public host name (certificate must match). The dashboard is https://DOMAIN, the API https://DOMAIN/api/v1.
DOMAIN=app.example.com

# Managed PostgreSQL covered by the host's BAA, TLS required, same region as the API (D-068 load test).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/alora?sslmode=verify-full
DATABASE_POOL_SIZE=20

# 48+ random bytes: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes every encrypted value (SSNs, 2FA secrets, documents) unreadable — keep it in a secrets
# manager with a backup.
PHI_ENCRYPTION_KEY=
PHI_ENCRYPTION_KEY_VERSION=1
PHI_ENCRYPTION_PREVIOUS_KEYS=

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
PASSWORD_MAX_AGE_DAYS=90
AUDIT_RETENTION_MONTHS=72
JOBS_ENABLED=true

# Notifications outside the app (D-071) — leave empty until the provider's BAA is signed (P2-11, P3-19).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Telephony EVV: set to https://DOMAIN; in Twilio, point the check-in number's voice webhook (POST) at
# https://DOMAIN/api/v1/ivr/voice
TWILIO_WEBHOOK_BASE_URL=
# Email (D-085): Azure Communication Services, under the same Microsoft BAA as the hosting. EMAIL_FROM is the plain
# sender address you added in Azure (e.g. DoNotReply@yourdomain.com); the display name is set there too.
EMAIL_PROVIDER=azure
EMAIL_FROM=DoNotReply@yourdomain.com
# Communication Services resource → Settings → Keys → Primary connection string.
AZURE_COMMUNICATION_CONNECTION_STRING=
# Fallback: EMAIL_PROVIDER=ses with AWS_REGION=us-east-1 plus AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for an IAM user
# allowed only ses:SendEmail (Amazon SES, own free AWS BAA). SendGrid signs no BAA — don't use it in production.
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=
FRONTEND_URL=https://app.example.com

# Set by docker-compose.prod.yml — listed so nobody overrides them by accident:
#   APP_ENV=production, APP_PORT=3001, TRUST_PROXY_HOPS=1, CORS_ORIGINS=https://DOMAIN
# Never set RATE_LIMITS_DISABLED or API_DOCS_ENABLED in production.
