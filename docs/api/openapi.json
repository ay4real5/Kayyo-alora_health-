          "gender": {
            "type": "string",
            "enum": [
              "female",
              "male",
              "other",
              "unknown"
            ]
          },
          "ssn": {
            "type": "string",
            "description": "Stored encrypted; the API only ever returns the last 4 digits."
          },
          "mrn": {
            "type": "string",
            "description": "Medical record number, unique within the agency.",
            "maxLength": 50
          },
          "phoneHome": {
            "type": "string"
          },
          "phoneCell": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "maxLength": 255,
