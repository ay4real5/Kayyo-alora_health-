{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ],
        "security": []
      }
    }
  },
  "info": {
    "title": "Alora Health Patient Portal API",
    "description": "Home health agency management API. All routes are under `/api/v1`.\n\nSuccess responses are wrapped as `{ \"success\": true, \"data\": …, \"meta\"?: { page, limit, total } }`.\nErrors are `{ \"success\": false, \"error\": { \"code\", \"message\", \"details\"? } }`.\n\nAuthenticate with `POST /api/v1/auth/login`, then send `Authorization: Bearer <accessToken>`.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 255,
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TwoFactorLoginDto": {
        "type": "object",
        "properties": {
          "twoFactorToken": {
            "type": "string",
            "maxLength": 2000
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "recoveryCode": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "twoFactorToken"
        ]
      },
      "TwoFactorCodeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "code"
        ]
      },
      "RegenerateRecoveryCodesDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "code",
          "password"
        ]
      },
      "DisableTwoFactorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "code",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string",
            "description": "12-128 characters with an uppercase letter, a lowercase letter, a number and a special character.",
            "minLength": 12,
            "maxLength": 128
          },
          "currentPassword": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "newPassword",
          "currentPassword"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "description": "Starting password, 12-128 characters with upper, lower, number and special character. The user must\nchange it at first login (mustChangePassword).",
            "minLength": 12,
            "maxLength": 128
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "format": "email"
          },
          "firstName": {
            "type": "string",
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "maxLength": 100
          },
          "phone": {
            "type": "string"
          },
          "roleIds": {
            "description": "Role ids: built-in roles, or this agency's custom roles.",
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "password",
          "email",
          "firstName",
          "lastName",
          "roleIds"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "maxLength": 100
          },
          "phone": {
            "type": "string"
          },
