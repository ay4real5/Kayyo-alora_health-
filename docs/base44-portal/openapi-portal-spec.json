            "enum": [
              "vacation",
              "sick",
              "personal",
              "bereavement",
              "other"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "startDate",
          "endDate",
          "type"
        ]
      },
      "DecideTimeOffDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
