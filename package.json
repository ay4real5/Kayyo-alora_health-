  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "@scarf/scarf": false
  },
  "overrides": {
    "mysql2": "^3.23.1",
    "deepmerge-ts": "^8.0.0"
  }
}
