# Builds apps/api together with the workspace packages it depends on.
# Build from the repo root: docker build -f docker/Dockerfile.api .
FROM node:24-alpine AS build
WORKDIR /repo
COPY package.json package-lock.json turbo.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
RUN npm ci --workspace @alora/api --workspace @alora/shared --include-workspace-root
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN npx turbo run build --filter=@alora/api...
RUN npm prune --omit=dev --workspace @alora/api --workspace @alora/shared

FROM node:24-alpine
ENV NODE_ENV=production
WORKDIR /repo
COPY --from=build /repo/node_modules node_modules
COPY --from=build /repo/packages/shared/package.json packages/shared/
COPY --from=build /repo/packages/shared/dist packages/shared/dist
COPY --from=build /repo/apps/api/package.json apps/api/
COPY --from=build /repo/apps/api/dist apps/api/dist
USER node
EXPOSE 3001
CMD ["node", "apps/api/dist/main.js"]
